# Copia este archivo a .env para desarrollo local. En producción, configura estas variables en Render.
ENV=dev
# Opcional: dominio propio. En Render, si falta, se usa RENDER_EXTERNAL_URL.
PUBLIC_BASE_URL=
DATABASE_URL=sqlite:///./nodosur.db

# Obligatorias en prod (mín. 12 caracteres). Genera con: python -c "import secrets;print(secrets.token_urlsafe(32))"
SECRET_KEY=
ADMIN_EMAIL=admin@nodosur.cl
ADMIN_PASSWORD=
AGENT_TOKEN=

# Correo (Gmail: smtp.gmail.com, puerto 587, usuario = tu Gmail, contraseña = "contraseña de aplicación")
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_TO=
CONTACT_TO=

# Asistente IA de la landing (opcional; sin clave responde en modo básico)
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-5-5

# true solo con un plan siempre encendido (en Free el agente lo despierta GitHub Actions)
ENABLE_SCHEDULER=false
